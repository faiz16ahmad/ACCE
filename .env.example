# ACCE configuration.
# Copy to `.env` and adjust. All variables are optional — V1 defaults run
# entirely on `stub` providers (no external API calls).

# --- Paths ----------------------------------------------------------------
ACCE_PATHS__OUTPUT_DIR=out
ACCE_PATHS__CACHE_DIR=.cache

# --- LLM: stub (default) | gemini ------------------------------------------
# Other providers (openai/anthropic/glm/deepseek/openrouter) are drop-in once
# implemented — they only need to satisfy the LLMProvider interface.
ACCE_LLM__PROVIDER=stub
ACCE_LLM__MODEL=gemini-2.5-flash
# API key: set ACCE_LLM__API_KEY or the GEMINI_API_KEY environment variable.
ACCE_LLM__API_KEY=
ACCE_LLM__TEMPERATURE=0.2
ACCE_LLM__MAX_OUTPUT_TOKENS=4096
# Optional API base override (e.g. a proxy/gateway):
ACCE_LLM__BASE_URL=

# --- Research --------------------------------------------------------------
ACCE_RESEARCH__FETCH_TIMEOUT=8.0
ACCE_RESEARCH__FETCH_RETRIES=2
ACCE_RESEARCH__MAX_EXCERPT_CHARS=2000
ACCE_RESEARCH__MAX_URLS=12
ACCE_RESEARCH__REFINE=true

# --- Script: educational|documentary|storytelling|news|top10|explainer ------
ACCE_SCRIPT__STYLE=explainer
ACCE_SCRIPT__WORDS_PER_MINUTE=150

# --- Media: ordered fallback chain (cache is always priority 1) -----------
# Pexels -> Pixabay -> Wikimedia is the V1 intent; only `stub` is available now.
ACCE_MEDIA__PROVIDERS=["stub"]

# --- Music (Pixabay Music preferred in the music milestone) ---------------
ACCE_MUSIC__PROVIDER=stub

# --- TTS ------------------------------------------------------------------
ACCE_TTS__PROVIDER=stub
ACCE_TTS__VOICE=en-US-Wavenet-D

# --- Audio (engine: stub | ffmpeg; ffmpeg requires the binary installed) --
ACCE_AUDIO__ENGINE=stub
ACCE_AUDIO__MUSIC_STYLE=ambient background music
ACCE_AUDIO__MUSIC_VOLUME=0.2
ACCE_AUDIO__NARRATION_VOLUME=1.0
ACCE_AUDIO__MASTER_GAIN=1.0

# --- Production -----------------------------------------------------------
ACCE_PRODUCTION__WIDTH=1920
ACCE_PRODUCTION__HEIGHT=1080
ACCE_PRODUCTION__FPS=30
ACCE_PRODUCTION__FFMPEG_PATH=

# --- Pipeline -------------------------------------------------------------
ACCE_PIPELINE__RETRIES=2
