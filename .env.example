# ACCE configuration.
# Copy to `.env` and adjust. All variables are optional — V1 defaults run
# entirely on `stub` providers (no external API calls).

# --- Paths ----------------------------------------------------------------
ACCE_PATHS__OUTPUT_DIR=out
ACCE_PATHS__CACHE_DIR=.cache

# --- LLM: stub (default) | gemini ------------------------------------------
# Other providers (openai/anthropic/glm/deepseek/openrouter) are drop-in once
# implemented — they only need to satisfy the LLMProvider interface.
ACCE_LLM__PROVIDER=stub
ACCE_LLM__MODEL=gemini-2.5-flash
# API key: set ACCE_LLM__API_KEY or the GEMINI_API_KEY environment variable.
ACCE_LLM__API_KEY=
ACCE_LLM__TEMPERATURE=0.2
ACCE_LLM__MAX_OUTPUT_TOKENS=4096
# Optional API base override (e.g. a proxy/gateway):
ACCE_LLM__BASE_URL=

# --- Research --------------------------------------------------------------
ACCE_RESEARCH__FETCH_TIMEOUT=8.0
ACCE_RESEARCH__FETCH_RETRIES=2
ACCE_RESEARCH__MAX_EXCERPT_CHARS=2000
ACCE_RESEARCH__MAX_URLS=12
ACCE_RESEARCH__REFINE=true

# --- Script: educational|documentary|storytelling|news|top10|explainer ------
ACCE_SCRIPT__STYLE=explainer
ACCE_SCRIPT__WORDS_PER_MINUTE=150

# --- Media: ordered fallback chain (cache is always priority 1) -----------
# Default is `stub` (no keys). For real assets use e.g.
#   ACCE_MEDIA__PROVIDERS=["pexels","pixabay","wikimedia"]
# Pexels/Pixabay need API keys below (or PEXELS_API_KEY / PIXABAY_API_KEY env).
ACCE_MEDIA__PROVIDERS=["stub"]
ACCE_MEDIA__PEXELS_API_KEY=
ACCE_MEDIA__PIXABAY_API_KEY=
ACCE_MEDIA__CANDIDATES=10
ACCE_MEDIA__SATISFACTORY_SCORE=0.6
ACCE_MEDIA__DOWNLOAD=true
ACCE_MEDIA__DOWNLOAD_TIMEOUT=15.0

# --- Music: ordered priority chain (Pixabay Music -> Local -> Stub) -------
# Default is `stub` (no keys). For real tracks:
#   ACCE_MUSIC__PROVIDERS=["pixabay","local","stub"]
# Drop royalty-free files into ACCE_MUSIC__LOCAL_DIR to use the local provider.
ACCE_MUSIC__PROVIDERS=["stub"]
ACCE_MUSIC__PIXABAY_API_KEY=
ACCE_MUSIC__LOCAL_DIR=assets/music
# Script style -> music genre (JSON env value, fully configurable):
# ACCE_AUDIO__STYLE_GENRES={"educational":"calm","storytelling":"cinematic","news":"neutral","documentary":"atmospheric","explainer":"ambient","top10":"upbeat"}

# --- TTS (provider: stub | edge | sarvam | auto; edge-tts = real narration, no API key) ---
# Install the optional extra:  uv sync --extra tts   (or: pip install edge-tts)
ACCE_TTS__PROVIDER=stub
ACCE_TTS__VOICE=en-US-AriaNeural
# Sarvam AI TTS (multilingual Indic narration, key required). Use `auto` so the
# language pack decides per language (en -> edge, hi -> sarvam):
#   ACCE_TTS__PROVIDER=auto
#   ACCE_TTS__API_KEYS={"sarvam":"your-sarvam-api-key"}

# --- Audio (engine: stub | ffmpeg; ffmpeg requires the binary installed) --
ACCE_AUDIO__ENGINE=stub
ACCE_AUDIO__MUSIC_DUCK=true
ACCE_AUDIO__MUSIC_STYLE=ambient background music
ACCE_AUDIO__MUSIC_VOLUME=0.2
ACCE_AUDIO__NARRATION_VOLUME=1.0
ACCE_AUDIO__MASTER_GAIN=1.0
ACCE_AUDIO__MUSIC_FADE=1.0
ACCE_AUDIO__NARRATION_FADE=0.2

# --- Production (renderer: stub | ffmpeg; stub needs no binary) -----------
ACCE_PRODUCTION__RENDERER=stub
ACCE_PRODUCTION__WIDTH=1920
ACCE_PRODUCTION__HEIGHT=1080
ACCE_PRODUCTION__FPS=30
ACCE_PRODUCTION__FFMPEG_PATH=
ACCE_PRODUCTION__FADE=0.5

# --- Quality (deterministic scoring; only errors block publishing) --------
ACCE_QUALITY__PENALTY_ERROR=25.0
ACCE_QUALITY__PENALTY_WARNING=5.0
ACCE_QUALITY__PENALTY_INFO=1.0
ACCE_QUALITY__READABILITY_MIN=30.0
ACCE_QUALITY__READABILITY_MAX=90.0
ACCE_QUALITY__DURATION_TOLERANCE=0.15

# --- Pipeline -------------------------------------------------------------
ACCE_PIPELINE__RETRIES=2
